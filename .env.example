PORT=3008
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5439/channel_manager_db?schema=public
RABBITMQ_URL=amqp://localhost:5672
BOOKING_SERVICE_URL=http://localhost:3004/v1
RATE_SERVICE_URL=http://localhost:3002/v1
CHANNEL_MANAGER_SERVICE_KEY=replace-with-random-32-plus-character-secret
CHANNEL_MANAGER_SIMULATOR_KEY=replace-with-a-different-random-32-plus-character-secret

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
